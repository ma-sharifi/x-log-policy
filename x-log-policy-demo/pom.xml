<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.xlogpolicy</groupId>
    <artifactId>x-log-policy-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>x-log-policy-demo</artifactId>
  <name>x-log-policy-demo</name>
  <description>Sample service proving the contract end to end. Not published.</description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <maven.install.skip>true</maven.install.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.xlogpolicy</groupId>
      <artifactId>x-log-policy-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- Required by the models openapi-generator emits. -->
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations</artifactId>
      <version>2.2.25</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
    <dependency>
      <groupId>org.openapitools</groupId>
      <artifactId>jackson-databind-nullable</artifactId>
      <version>0.2.6</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 1. Generate the DTOs from the same document the policies come from. -->
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>generate-models</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${project.basedir}/src/main/resources/openapi/customer-api.yaml</inputSpec>
              <!-- The spring generator emits plain POJOs; the java client generator would drag in its
                   whole ApiClient runtime for models we only ever deserialise into. -->
              <generatorName>spring</generatorName>
              <library>spring-boot</library>
              <generateApis>false</generateApis>
              <generateApiTests>false</generateApiTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelTests>false</generateModelTests>
              <generateModelDocumentation>false</generateModelDocumentation>
              <generateSupportingFiles>false</generateSupportingFiles>
              <modelPackage>io.xlogpolicy.demo.model</modelPackage>
              <apiPackage>io.xlogpolicy.demo.api</apiPackage>
              <configOptions>
                <sourceFolder>src/main/java</sourceFolder>
                <useJakartaEe>true</useJakartaEe>
                <useSpringBoot3>true</useSpringBoot3>
                <openApiNullable>false</openApiNullable>
                <hideGenerationTimestamp>true</hideGenerationTimestamp>
                <useTags>true</useTags>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- 2. Emit the runtime registry and fail the build on uncovered PII-looking fields. -->
      <plugin>
        <groupId>io.xlogpolicy</groupId>
        <artifactId>x-log-policy-maven-plugin</artifactId>
        <version>${project.version}</version>
        <executions>
          <execution>
            <id>x-log-policy</id>
            <goals>
              <!-- Stamps @LogPolicy onto the generated models ... -->
              <goal>annotate-sources</goal>
              <!-- ... writes the registry that also covers hand-written and free-form payloads ... -->
              <goal>generate-metadata</goal>
              <!-- ... and fails the build if a PII-looking field declares no policy. -->
              <goal>validate</goal>
            </goals>
            <configuration>
              <specs>
                <spec>${project.basedir}/src/main/resources/openapi/customer-api.yaml</spec>
              </specs>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
      </plugin>
    </plugins>
  </build>
</project>
